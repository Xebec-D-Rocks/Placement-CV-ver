# Copy to .env and adjust. Defaults work out of the box for local Docker use.
POSTGRES_DB=coalguard
POSTGRES_USER=coalguard
POSTGRES_PASSWORD=coalguard
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
CORS_ALLOWED_ORIGINS=
