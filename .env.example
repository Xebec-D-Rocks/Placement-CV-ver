# =====================================================================
# CoalGuard - Environment configuration
# ---------------------------------------------------------------------
# Copy this file to `.env` in the project root and adjust as needed.
# DEFAULTS WORK OUT OF THE BOX for a local demo (nothing required).
# There are NO hard-coded paths: every relative path is derived from
# the project folder itself, so you may rename/move the folder freely.
# All values below are optional - remove the line to use the default.
#
#   CP  .env  ->  docker-compose.yml   (host port mapping, container names)
#   ???  .env  ->  config/settings.py   (Django application settings)
# =====================================================================

# --- Naming ---------------------------------------------------------
# Prefix used for Docker container names (coalguard_web, coalguard_db ...).
# Change it if container names collide with another project on this PC.
COMPOSE_PROJECT_NAME=coalguard

# --- Host ports -----------------------------------------------------
# Port exposed on THIS machine for the web app, Postgres and Redis.
# Change e.g. WEB_PORT=8080 if port 8000 is already taken.
WEB_PORT=8000
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379

# --- PostgreSQL (used only by the Docker stack) ---------------------
POSTGRES_DB=coalguard
POSTGRES_USER=coalguard
POSTGRES_PASSWORD=coalguard
# Host/port the web container uses to reach Postgres INSIDE the network.
# Only change these if you alter docker-compose.yml.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (queue + cache for the Docker stack) ---------------------
REDIS_URL=redis://redis:6379/0

# --- Django ---------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-change-me
# 1 = debug, friendly error pages, ALLOWED_HOSTS="*". 0 = production locked down.
DJANGO_DEBUG=1
# Comma-separated hosts allowed when DJANGO_DEBUG=0.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],0.0.0.0,web

# --- CORS (mobile app / cross-origin API clients) -------------------
CORS_ALLOWED_ORIGINS=

# --- Local-only fallback WITHOUT Docker (run_local.bat / run_local.sh)
# Is used automatically by those launchers - no need to set it manually.
# USE_SQLITE=1